{
  "name": "fourlab-erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "npm run build && wrangler dev",
    "db:types": "supabase gen types --lang=typescript --project-id fihthjhpigwbaievvcay --schema public > src/shared/db/database.types.ts",
    "db:login": "supabase login",
    "db:migration:new": "supabase migration new",
    "db:migrate": "supabase db push",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:pull": "supabase db pull",
    "db:reset": "supabase db reset",
    "db:up": "supabase migration up",
    "db:functions": "supabase functions serve invite-user update-user",
    "db:seed": "supabase db query --linked -f supabase/seed.sql",
    "db:link": "supabase link --project-ref fihthjhpigwbaievvcay",
    "tunnel": "npx ngrok http 5173 --host-header=\"localhost\"",
    "test": "vitest",
    "test:run": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "gate": "tsc --noEmit && npm run lint && npm run test:run && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource/material-symbols-outlined": "^5.2.45",
    "@fontsource/public-sans": "^5.2.7",
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.46.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.106.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.113.0"
  }
